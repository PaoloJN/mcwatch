	"environment": "client",
	"entrypoints": {
		"client": ["dev.paolo.mcwatch.McWatchClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
